# ==============================================================================
# Переменные окружения проекта (Environment Configuration)
# Скопируйте этот файл в .env и укажите ваши реальные значения.
# ВНИМАНИЕ: Файл .env добавлен в .gitignore и никогда не должен попадать в Git!
# ==============================================================================

# Общие настройки приложения
APP_ENV=development
APP_DEBUG=true
APP_PORT=3000

# Интеграция с искусственным интеллектом (если применимо)
# AI_PROVIDER=gemini | openai | claude | local
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# База данных / Хранилище (если применимо)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=app_db
# DB_USER=postgres
# DB_PASSWORD=secret

# Внешние API и сервисы
# EXTERNAL_API_URL=https://api.example.com
# EXTERNAL_API_TOKEN=your_token_here
